# Copy to .env and edit. MySQL 9.x is supported (uses caching_sha2_password).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=innovation_hub

# POC only: the single mock user. RBAC will replace this later.
POC_USER_EMAIL=alex.mwangi@example.com

# ---------------------------------------------------------------------------
# LMS module
# ---------------------------------------------------------------------------

# Turn on the real role matrix in app/security.py. Leave off for the POC, where
# the single mock user is allowed everything.
LMS_ENFORCE_ROLES=false

# File storage. Only "local" is implemented; the abstraction in app/storage.py
# is where an S3 backend would be added.
STORAGE_BACKEND=local
# STORAGE_ROOT=C:/path/to/storage        # defaults to backend/var/storage
MAX_UPLOAD_BYTES=209715200               # 200 MiB per uploaded file
MAX_ARCHIVE_BYTES=524288000              # 500 MiB per export archive
MAX_EXTRACTED_BYTES=1073741824           # 1 GiB unpacked (zip-bomb guard)

# ---------------------------------------------------------------------------
# OpenMAIC (AI course generation). Leave OPENMAIC_BASE_URL empty to disable;
# the LMS works fully without it apart from AI generation.
#
# Run OpenMAIC on a PRIVATE network. Employees must never reach it: it holds
# the AI provider keys and the generator. See docs/openmaic-integration-design.md.
# ---------------------------------------------------------------------------

OPENMAIC_BASE_URL=
# RECOMMENDED: run OpenMAIC with OWNER_SINGLE_USER=true (in OpenMAIC's own
# environment, not this file). In that mode every request is one fixed owner and
# NO cookie is needed, so leave OPENMAIC_COOKIE empty. Verified in OpenMAIC's
# lib/server/identity/single-user.ts. Keep OpenMAIC on a private network: in
# this mode anyone who can reach it is the owner.
# Only for an OpenMAIC left in its default per-browser mode: a session cookie
# (anonymous_id=...) captured from a browser. It is a secret and may expire.
OPENMAIC_COOKIE=
# Only if the OpenMAIC instance sets ACCESS_CODE. Minet exchanges it once for the
# `openmaic_access` cookie (POST /api/access-code/verify); it is never sent as a
# header. Leave empty when OpenMAIC runs with ACCESS_CODE unset.
OPENMAIC_ACCESS_CODE=
OPENMAIC_TIMEOUT_SECONDS=60
OPENMAIC_UPLOAD_TIMEOUT_SECONDS=300
# OpenMAIC's own default is 2 concurrent runs per owner.
OPENMAIC_MAX_ACTIVE_RUNS=2
OPENMAIC_JOB_TIMEOUT_SECONDS=2700        # abandon a run after 45 minutes
OPENMAIC_POLL_SECONDS=15

# Background worker (python -m app.jobs.worker)
WORKER_IDLE_SECONDS=5

# ---------------------------------------------------------------------------
# Certificates
# ---------------------------------------------------------------------------
CERTIFICATE_ORGANISATION=Minet
CERTIFICATE_SIGNATORY=Head of Innovation
CERTIFICATE_SIGNATORY_TITLE=Minet Innovation Hub
# Used to build the public verification URL printed on each certificate.
PUBLIC_BASE_URL=http://localhost:5173

LOG_LEVEL=INFO
